# --- Servidor ---
PORT=3001
CLIENT_URL=http://localhost:5173

# --- Banco (MongoDB local ou Atlas) ---
MONGO_URI=mongodb://127.0.0.1:27017/cd_agendamento

# --- Autenticação ---
# Gere um valor longo e aleatório. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-grande
JWT_EXPIRES_IN=8h

# --- Regras de negócio ---
# Quantas docas recebem ao mesmo tempo (máx. de agendamentos aprovados por data+horário)
DOCAS=2

# --- E-mail (se SMTP_HOST ficar vazio, os e-mails são apenas exibidos no console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agendamento CD <nao-responder@cd.local>"
# Quem recebe o aviso de nova solicitação (separe por vírgula). Se vazio, vai para todos os admins.
NOTIFY_EMAILS=

# --- Seed (npm run seed) ---
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@cd.local
ADMIN_PASSWORD=admin123
